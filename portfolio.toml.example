# 持仓配置文件示例
# Portfolio Configuration Example

# ========== 账户信息 ==========
[account]
total_equity = 500000       # 总资产（元）— 必填，风控模块依赖
total_market_value = 350000 # (可选) 总市值，仅供记录
position_ratio = 0.70       # (可选) 仓位比例，仅供记录
update_time = "2026-01-01 09:00" # (可选) 更新时间，仅供记录

# 说明：
# - code: 股票代码（A股6位数字，港股5位数字）
# - name: 股票名称
# - market: 市场（上海/深圳/沪港通/深港通）
# - quantity: 持仓数量（股）
# - cost_price: 成本价（元）
# - buy_date: 买入日期，格式 YYYYMMDD
#     只要 trade_plan.stop_loss_strategy 或 risk_rules.stop_loss_strategy 使用
#     entry_day_low_guard / 未来其他入场日锚定策略，
#     就必须显式填写 buy_date，方便后续维护时明确识别
# - trade_plan: (可选) 已确认的交易计划，使用内联 table，建议 AI 优先维护这一层
#     trade_plan = {status = "active", stop_loss_strategy = "...", plan_note = "..."}
#     其中 stop_loss_strategy 可选 atr / entry_day_low_guard / equity_risk_budget
# 使用方法：
# 1. 运行 ./scripts/init_project.sh 自动生成配置文件
# 2. 或手动复制本文件为 portfolio.toml，修改为你的实际持仓
# 3. 运行 ./quickstart.sh risk-data 检查风控补数需求
# 4. 运行 ./quickstart.sh risk 执行风控检查；缺口会由行情源补齐
# 5. 只有外部 JSON 补数时，才需要运行 ./quickstart.sh risk-merge

[[holdings]]
code = "600519"
name = "贵州茅台"
market = "上海"
quantity = 100
cost_price = 1800.0
# 必填：trade_plan.stop_loss_strategy = "entry_day_low_guard" 依赖 buy_date
buy_date = "20240102"
trade_plan = {status = "active", stop_loss_strategy = "entry_day_low_guard", plan_note = "跌破买入日低点下5tick执行"}
risk_rules = {stop_loss_params = {buffer_ticks = 5}, trailing_stop_atr_multiplier = 2.5}

[[holdings]]
code = "000001"
name = "平安银行"
market = "深圳"
quantity = 1000
cost_price = 12.5
trade_plan = {status = "active", stop_loss_strategy = "equity_risk_budget", plan_note = "单票最多亏总权益2%"}
risk_rules = {max_loss_pct_of_equity = 0.02}

[[holdings]]
code = "00700"
name = "腾讯控股"
market = "沪港通"
quantity = 100
cost_price = 350.0

[[holdings]]
code = "159792"
name = "互联网ETF"
market = "深圳"
quantity = 10000
cost_price = 0.85

# ========== 待买入观察列表（可选） ==========
# target_buy_price: 回调到该价格及以下，提示关注买点
# breakout_price: 向上突破该价格，提示突破买点
# signal_rules: 预留给自定义观察信号插件的参数 table

[[watchlist]]
code = "300750"
name = "宁德时代"
market = "深圳"
target_buy_price = 180.0
breakout_price = 205.0
signal_rules = {preferred_strategy = "target_buy"}
notes = "等回调缩量企稳，或放量突破后跟踪"

[[watchlist]]
code = "00700"
name = "腾讯控股"
market = "沪港通"
target_buy_price = 320.0
notes = "只做核心资产观察，不追高"
